package systemd

version     = 0.1.0
authors     = "Matthew Mosior"
license     = "BSD-3 Clause"
brief       = "A systemd library"
depends     = base >= 0.7.0
            , elin
            , posix
sourcedir   = "src"
modules     = System.Systemd.Daemon
            , System.Systemd.Daemon.Fd
            , System.Systemd.Internal
prebuild    = "make -C support"
preinstall  = "make -C support install"
